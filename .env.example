# ─── App mode ─────────────────────────────────────────────
# demo = mock fallbacks when services unavailable (default for local dev)
# production = require configured services; stricter auth
# Use production for real AI + no demo fallbacks (required on live site)
GM_APP_MODE=demo

# Show banner in UI (set false in production)
NEXT_PUBLIC_DEMO_MODE=true

# ─── Database (PostgreSQL — required for live deploy) ─────
# Local: Neon free tier https://neon.tech or Docker Postgres
# Neon: use the pooled connection string from the dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (required for production sign-in) ───────────────
NEXTAUTH_URL="http://localhost:3000"
# Public site URL for SEO (sitemap, Open Graph) — use your live domain in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production example: NEXT_PUBLIC_APP_URL="https://www.gmconsultations.com"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Course textbooks (Research Understanding) ───────────────
# Comma-separated emails allowed to upload shared textbooks for all students
# PLATFORM_TEXTBOOK_ADMIN_EMAILS=97transformative@gmail.com

# ─── Business management (/manage) ─────────────────────────
# Comma-separated emails for Skyrapay internal CRM (clients, income, expenses)
# BUSINESS_ADMIN_EMAILS=97transformative@gmail.com

# ─── Trial / paywall ───────────────────────────────────────
# Full access to AI tools for this many days after account signup
TRIAL_DAYS=3

# ─── AI providers ─────────────────────────────────────────
# Required for live learning guides in Research Understanding (and other AI tools)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Grok (xAI) — powers the Research Suite via HTTPS API (not the terminal CLI installer)
# Get a key: https://console.x.ai/
# Optional local dev tool (your machine only, not Vercel): curl -fsSL https://x.ai/cli/install.sh | bash
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# ─── Stripe (subscriptions per portal) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (create in Stripe Dashboard per tier in src/lib/portals.ts)
STRIPE_PRICE_STU_PRO=
STRIPE_PRICE_STU_ASSISTANT=
STRIPE_PRICE_INST_SUPERVISOR=
STRIPE_PRICE_INST_MARKER=
STRIPE_PRICE_ANA_PRO=

# ─── AI detection (choose one or more; Auto picks best available) ─
# AI_DETECTOR_PROVIDER=auto
# GPTZERO_API_KEY=          # Dedicated detector — https://gptzero.me/developers
# GEMINI_API_KEY=           # LLM sentence scoring (also used by ai-providers)
# XAI_API_KEY=              # Grok LLM sentence scoring

# ─── Live chat (marketing site) ───────────────────────────
# WhatsApp works automatically via company phone in site-content.
# Optional Tawk.to live chat — https://tawk.to → Administration → Property ID & Widget ID
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=

# ─── Contact form (email + SMS on submit) ─────────────────
# Defaults: 97transformative@gmail.com and both +264 numbers from site-content
# CONTACT_NOTIFY_EMAIL=97transformative@gmail.com
# CONTACT_NOTIFY_PHONES=+264812986481,+264818774482

# Email — use Resend (recommended on Vercel) OR Gmail SMTP
# RESEND_API_KEY=          # set on Vercel
# Default sender (also used if CONTACT_FROM_EMAIL is not set on Vercel):
# CONTACT_FROM_EMAIL=GM Consultations <hello@gmconsultations.com>

# SMTP (e.g. Gmail App Password — https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=97transformative@gmail.com
# SMTP_PASS=
# SMTP_FROM=Skyrapay Consultations <97transformative@gmail.com>

# SMS — pick ONE provider (texts both notify numbers)

# Option A: Africa's Talking (recommended for Namibia) — https://africastalking.com
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=Skyrapay

# Option B: Twilio — https://www.twilio.com
# Enable Namibia under Messaging → Geo permissions
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1xxxxxxxxxx

# ─── Optional integrations ────────────────────────────────
# Semantic Scholar (literature search — works without key at low rate)
SEMANTIC_SCHOLAR_API_KEY=

# CORE open-access papers — https://core.ac.uk/services/api
CORE_API_KEY=

# Upload storage — local folder for dev; on Vercel add Blob (auto-sets BLOB_READ_WRITE_TOKEN)
UPLOAD_DIR="./uploads"
# BLOB_READ_WRITE_TOKEN=   # Added automatically when Vercel Blob is connected
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
