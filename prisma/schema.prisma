generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          String    @default("student")
  portal        String    @default("student")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  documents     Document[]
  usageLogs     UsageLog[]
  understandingBooks UnderstandingBook[]
  supervisorFeedbackReviews SupervisorFeedbackReview[]
  campusMemberships CampusMembership[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/** Skyrapay internal business management — clients, services, income & expenses */
model BizClient {
  id          String          @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  location    String?
  status      String          @default("active")
  category    String          @default("general")
  notes       String?         @db.Text
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  engagements BizEngagement[]
  income      BizIncome[]
  quotations  BizQuotation[]
  invoices    BizInvoice[]

  @@index([status])
  @@index([createdAt])
}

/** Client quotations — ex-VAT line items, 15% VAT, emailed automatically */
model BizQuotation {
  id            String     @id @default(cuid())
  quoteNumber   String     @unique
  clientId      String
  client        BizClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId  String?
  title         String
  itemsJson     String     @db.Text
  subtotalExVat Float
  vatRate       Float      @default(0.15)
  vatAmount     Float
  totalInclVat  Float
  currency      String     @default("NAD")
  notes         String?    @db.Text
  validUntil    DateTime?
  status        String     @default("draft")
  sentAt        DateTime?
  emailSent     Boolean    @default(false)
  emailError    String?
  createdBy     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

/** Tax invoices — ex-VAT line items, 15% VAT, balance due & automated reminders */
model BizInvoice {
  id                   String         @id @default(cuid())
  invoiceNumber        String         @unique
  clientId             String
  client               BizClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId         String?
  engagement           BizEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  title                String
  itemsJson            String         @db.Text
  subtotalExVat        Float
  vatRate              Float          @default(0.15)
  vatAmount            Float
  totalInclVat         Float
  amountPaid           Float          @default(0)
  balanceDue           Float
  currency             String         @default("NAD")
  invoiceType          String         @default("service")
  notes                String?        @db.Text
  dueDate              DateTime?
  reminderEnabled      Boolean        @default(true)
  reminderIntervalDays Int            @default(3)
  lastReminderAt       DateTime?
  nextReminderAt       DateTime?
  status               String         @default("draft")
  sentAt               DateTime?
  emailSent            Boolean        @default(false)
  emailError           String?
  createdBy            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  notifications        BizNotificationLog[]

  @@index([clientId])
  @@index([engagementId])
  @@index([status])
  @@index([balanceDue])
  @@index([nextReminderAt])
  @@index([createdAt])
}

model BizEngagement {
  id              String        @id @default(cuid())
  clientId        String
  client          BizClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  serviceSlug     String
  packageId       String?
  status          String        @default("inquiry")
  progressPercent Int           @default(0)
  quotedAmount    Float?
  paidAmount      Float         @default(0)
  currency        String        @default("NAD")
  startDate       DateTime?
  dueDate         DateTime?
  notes           String?       @db.Text
  paymentPlan     String?
  depositPaid     Boolean       @default(false)
  balancePaid     Boolean       @default(false)
  tasks           BizTask[]
  income          BizIncome[]
  expenses        BizExpense[]
  notifications   BizNotificationLog[]
  invoices        BizInvoice[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([serviceSlug])
}

model BizTask {
  id           String        @id @default(cuid())
  engagementId String
  engagement   BizEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  stepKey      String?
  durationNote String?
  done         Boolean       @default(false)
  sortOrder    Int           @default(0)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([engagementId])
}

/** Internal business to-do & planning — reminders for team operations and developments */
model BizTodo {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  category        String    @default("general")
  categoryOther   String?
  priority        String    @default("medium")
  status          String    @default("pending")
  dueDate         DateTime?
  reminderEnabled Boolean   @default(true)
  lastReminderAt  DateTime?
  completedAt     DateTime?
  sortOrder       Int       @default(0)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([category])
  @@index([priority])
}

model BizNotificationLog {
  id           String         @id @default(cuid())
  engagementId String?
  engagement   BizEngagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  invoiceId    String?
  invoice      BizInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel      String
  recipient    String
  message      String        @db.Text
  stepKey      String?
  success      Boolean       @default(true)
  error        String?
  createdAt    DateTime      @default(now())

  @@index([engagementId, createdAt])
  @@index([invoiceId, createdAt])
}

model BizIncome {
  id            String         @id @default(cuid())
  clientId      String?
  client        BizClient?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engagementId  String?
  engagement    BizEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  amount        Float
  currency      String         @default("NAD")
  date          DateTime
  category      String         @default("service_payment")
  description   String?
  paymentMethod String?
  createdAt     DateTime       @default(now())

  @@index([date])
  @@index([clientId])
}

model BizExpense {
  id           String         @id @default(cuid())
  engagementId String?
  engagement   BizEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  amount       Float
  currency     String         @default("NAD")
  date         DateTime
  category     String         @default("other")
  vendor       String?
  description  String?
  createdAt    DateTime       @default(now())

  @@index([date])
  @@index([engagementId])
}

/** Student-uploaded supervisor-returned documents (external institutions) */
model SupervisorFeedbackReview {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  supervisorName     String?
  studentFileName    String?
  supervisorFileName String
  studentText        String?  @db.Text
  supervisorText     String   @db.Text
  analysisJson       String?  @db.Text
  status             String   @default("processing")
  mode               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portal               String
  tierId               String
  status               String    @default("inactive")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Document {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  mimeType  String
  size      Int
  storageKey String
  portal    String?
  createdAt DateTime @default(now())
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  portal    String?
  mode      String
  metadata  String?
  createdAt DateTime @default(now())
}

/** Shared course textbooks (userId null) — all students get topic content from these */
model UnderstandingBook {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  uploadedBy  String?
  title       String
  fileName    String
  mimeType    String
  size        Int
  textContent String   @db.Text
  moduleScope String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/** Every client request across all services — hosting orders, shop purchases, IT service & contact inquiries */
model ServiceInquiry {
  id          String   @id @default(cuid())
  kind        String   // "contact" | "purchase" | "hosting_order"
  name        String
  email       String
  phone       String?
  subject     String?
  packageId   String?
  packageName String?
  message     String?  @db.Text
  itemsJson   String?  @db.Text
  totalNad    Float?
  orderRef    String?
  status      String   @default("new") // new | in_progress | resolved
  adminNotes  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([kind])
  @@index([createdAt])
}

/** Server-side errors captured from API routes so admins can assist clients */
model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String   @db.Text
  stack     String?  @db.Text
  userId    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

/** Temporary store for async Copyleaks scan webhooks (polled by /api/plagiarism/check) */
model PlagiarismScanCache {
  scanId    String   @id
  status    String   @default("pending")
  payload   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ─── SmartCampus 360 — multi-tenant university ERP ─────────────────────────

model CampusTenant {
  id           String              @id @default(cuid())
  slug         String              @unique
  name         String
  tagline      String?
  institutionType String           @default("college")
  customDomain String?
  primaryColor String              @default("#2563EB")
  logoUrl      String?
  campusesJson String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  memberships  CampusMembership[]
  students     CampusStudent[]
  programmes   CampusProgramme[]
  crmLeads     CampusCrmLead[]
  credentials  CampusCredential[]

  @@index([institutionType])
}

model CampusMembership {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    CampusTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime     @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
}

model CampusStudent {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               CampusTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentNumber        String
  name                 String
  email                String?
  programmeCode        String?
  enrollmentYear       Int?
  attendancePct        Float?
  averageMark          Float?
  feesOutstanding      Float        @default(0)
  failureRisk          Float        @default(0)
  dropoutRisk          Float        @default(0)
  feeDefaultRisk       Float        @default(0)
  graduationLikelihood Float?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([tenantId, studentNumber])
  @@index([tenantId, failureRisk])
}

model CampusProgramme {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    CampusTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  faculty   String?
  nqfLevel  Int?
  passRate  Float?

  @@unique([tenantId, code])
}

model CampusCrmLead {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    CampusTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  leadType  String
  stage     String
  email     String?
  phone     String?
  notes     String?      @db.Text
  createdAt DateTime     @default(now())

  @@index([tenantId, stage])
}

model CampusCredential {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         CampusTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentName    String
  studentNumber  String
  qualification  String
  yearAwarded    Int
  verifyCode     String       @unique
  blockchainHash String?
  issuedAt       DateTime     @default(now())

  @@index([tenantId])
}
